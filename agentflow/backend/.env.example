# ═══════════════════════════════════════════════════
# AgentFlow — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── LLM API Keys (set at least one) ─────────────────
MOONSHOT_API_KEY=sk-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Default model used by all agents (can be overridden per-node)
# Examples: moonshot/moonshot-v1-32k, gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022, gemini/gemini-1.5-flash
DEFAULT_MODEL=moonshot/moonshot-v1-32k

# ── Database (Phase 4+) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# ── Redis / Arq (Phase 4+) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT secret (use a long random string in production)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Logging ───────────────────────────────────────────
# "json" for production, "console" for local dev
LOG_FORMAT=console
LOG_LEVEL=INFO

# ── Execution Limits ─────────────────────────────────
DEFAULT_NODE_TIMEOUT_SECONDS=60
DEFAULT_MAX_STEPS=100
DEFAULT_MAX_COST_USD=5.0
